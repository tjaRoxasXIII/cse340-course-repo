<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Here are the service categories:</h2>
    <ul>
        <% categories.forEach(category=> { %>
            <li><strong><a href="/category/<%= category.category_id %>"><%= category.name %></a></strong></li>
        <% }); %>
    </ul>
    <p><a href="/new-category">Add a new category</a></p>
</main>
<%- include('partials/footer') %>