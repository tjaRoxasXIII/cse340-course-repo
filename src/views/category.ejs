<%- include('partials/header') %>

    <main>
        <h1>
            <%= category.name %>
        </h1>

        <h2>Projects in this category:</h2>

        <% if (projects.length===0) { %>
            <p>No projects are assigned to this category yet.</p>
            <% } else { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <a href="/project/<%= project.project_id %>">
                                <strong>
                                    <%= project.title %>
                                </strong>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } %>
        <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
    </main>

    <%- include('partials/footer') %>